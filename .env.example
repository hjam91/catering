# ========================================================
# UMBERS FOOD CATERING SERVICE - ENVIRONMENT CONFIGURATION
# ========================================================

# Brevo (formerly Sendinblue) Transactional Email API
# Get your free API key at https://app.brevo.com/settings/keys/api
# Free plan includes 300 free transactional emails every day.
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Verified Sender Email (must be verified in Brevo Dashboard -> Senders & IP)
BREVO_SENDER_EMAIL=orders@umberscatering.com
BREVO_SENDER_NAME=Umbers Food Catering Service

# Notification Recipient Email (where chef & kitchen staff receive new booking alerts)
BREVO_NOTIFICATION_EMAIL=chefumber@gmail.com

# Optional: Client-side public fallback for static deployments
NEXT_PUBLIC_BREVO_API_KEY=xkeysib-your-brevo-api-key-here
NEXT_PUBLIC_BREVO_SENDER_EMAIL=orders@umberscatering.com
NEXT_PUBLIC_BREVO_SENDER_NAME=Umbers Food Catering Service
NEXT_PUBLIC_BREVO_NOTIFY_EMAIL=chefumber@gmail.com
